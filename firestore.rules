rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // 🔐 FUNCIONES AUXILIARES DE SEGURIDAD
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRegister() {
      return get(/databases/$(database)/documents/registers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRegister().role == 'admin';
    }

    function isCoordinador() {
      return isAuthenticated() && getUserRegister().role == 'coordinador';
    }

    function isAdminOrCoordinador() {
      return isAdmin() || isCoordinador();
    }

    function isGerente() {
      return isAuthenticated() && getUserRegister().role == 'gerente';
    }

    function isAdminOrGerente() {
      return isAdmin() || isGerente();
    }

    function isActiveUser() {
      return isAuthenticated() && getUserRegister().activo == true;
    }

    function hasAreaAssigned() {
      return isAuthenticated() &&
             getUserRegister().areaAsignada != null &&
             getUserRegister().areaAsignada != 'sin_asignar';
    }

    function ownsArea(area) {
      return isAuthenticated() && getUserRegister().areaAsignada == area;
    }

    // Mismo patrón que el frontend (RegistersService.loginWithGoogle),
    // pero exigido acá también porque el chequeo en Angular es
    // saltable desde devtools llamando al SDK de Firebase directo.
    function hasAllowedEmail() {
      return isAuthenticated() &&
             (request.auth.token.email.matches('^.+[.]gestium@gmail[.]com$') ||
              request.auth.token.email.matches('^.+@gestium-sli[.]com$'));
    }

    // ============================================
    // 📋 registers — perfiles/roles (fuente de verdad)
    // ============================================
    match /registers/{userId} {
      // Solo usuarios logueados de la intranet, nunca público.
      allow read: if isAuthenticated();

      // Auto-registro: siempre como 'empleado', nunca con rol elevado.
      allow create: if isAuthenticated() &&
                       hasAllowedEmail() &&
                       request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.role == 'empleado';

      // El propio usuario no puede cambiarse su rol/área ni darse acceso a
      // Trámites del IESS; admin sí puede.
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.areaAsignada == resource.data.areaAsignada &&
         request.resource.data.get('tramitesIess', false) == resource.data.get('tramitesIess', false)) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // 🏢 areasOficina
    // ============================================
    match /areasOficina/{areaId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // 📊 area_activities — agenda por área
    // Empleado: solo su área. Admin/coordinador: todas.
    // ============================================
    match /area_activities/{activityId} {
      allow read: if isAuthenticated() && (
        isAdminOrCoordinador() || ownsArea(resource.data.area)
      );

      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       hasAreaAssigned() &&
                       request.resource.data.creadoPor == request.auth.uid &&
                       request.resource.data.titulo != null &&
                       request.resource.data.estado != null &&
                       (isAdminOrCoordinador() ||
                        request.resource.data.area == getUserRegister().areaAsignada);

      // No se puede cambiar el área ni el creador.
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       (resource.data.creadoPor == request.auth.uid || isAdminOrCoordinador()) &&
                       request.resource.data.area == resource.data.area &&
                       request.resource.data.creadoPor == resource.data.creadoPor;

      // Recordatorios de la Bitácora de Gestiones (IESS): cualquier integrante
      // del área puede darles seguimiento aunque no los haya creado, pero solo
      // en lo necesario para eso — nunca título, descripción, prioridad, área
      // ni el vínculo con el coactivado. (Las allow de un mismo método se
      // combinan con OR, así que esta regla se suma a la anterior.)
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       resource.data.get('coactivadoId', null) != null &&
                       ownsArea(resource.data.area) &&
                       request.resource.data.area == resource.data.area &&
                       request.resource.data.creadoPor == resource.data.creadoPor &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['estado', 'fechaCompletada', 'notas', 'fechaLimite', 'responsable', 'responsableNombre']);

      allow delete: if isAuthenticated() &&
                       isActiveUser() &&
                       (resource.data.creadoPor == request.auth.uid || isAdminOrCoordinador());
    }

    // ============================================
    // 📞 IESS — Bitácora de Gestiones
    // Coactivados (ID = cédula/RUC) y su historial de gestiones. Lo ve y
    // registra el área IESS; admin/coordinador entran a todas las áreas.
    // ============================================
    function esDelAreaIess() {
      return isAuthenticated() && isActiveUser() &&
             (isAdminOrCoordinador() || ownsArea('iess'));
    }

    match /coactivados/{cedula} {
      allow read: if esDelAreaIess();

      // La cédula del documento debe coincidir con su ID (evita duplicados
      // por typos) y el creador siempre es quien lo escribe.
      allow create: if esDelAreaIess() &&
                       request.resource.data.cedula == cedula &&
                       request.resource.data.nombre is string &&
                       request.resource.data.nombre.size() > 0 &&
                       request.resource.data.cartera is string &&
                       request.resource.data.creadoPor.uid == request.auth.uid;

      // Nombre, cartera y los datos de contacto se pueden corregir; cédula y
      // creador quedan fijos.
      allow update: if esDelAreaIess() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['nombre', 'nombreBusqueda', 'nombrePalabras', 'cartera', 'representanteLegal', 'telefono', 'correo']);

      allow delete: if isAdmin();
    }

    // Las gestiones son el registro de qué se hizo con cada coactivado: las
    // crea cualquiera del área, cualquiera del área puede corregir su tipo y
    // texto (queda sellado quién y cuándo editó) y solo admin puede borrarlas.
    match /gestiones_coactivado/{gestionId} {
      allow read: if esDelAreaIess();

      allow create: if esDelAreaIess() &&
                       request.resource.data.registradoPor.uid == request.auth.uid &&
                       request.resource.data.coactivadoId is string &&
                       request.resource.data.tipo in ['llamada', 'correo', 'mensaje', 'reunion', 'otro', 'migrado'] &&
                       request.resource.data.descripcion is string &&
                       request.resource.data.descripcion.size() > 0;

      // Quién la registró, cuándo y de qué coactivado son inmutables: de ahí
      // salen las métricas de gestión por integrante.
      allow update: if esDelAreaIess() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['tipo', 'descripcion', 'observacionGeneral', 'editadoPor', 'fechaEdicion']) &&
                       request.resource.data.tipo in ['llamada', 'correo', 'mensaje', 'reunion', 'otro', 'migrado'] &&
                       request.resource.data.descripcion is string &&
                       request.resource.data.descripcion.size() > 0 &&
                       request.resource.data.editadoPor.uid == request.auth.uid;

      allow delete: if isAdmin();
    }

    // Títulos de crédito (ID = número de título, no se repite). Se cargan
    // por importación masiva desde Excel/CSV — solo admin, para no dejar
    // que una carga a mano rompa la validación de duplicados del importador.
    match /titulos_credito/{numero} {
      allow read: if esDelAreaIess();
      allow create: if isAdmin() && request.resource.data.numero == numero;
      allow update, delete: if isAdmin();

      // Registrar un abono/pago total (cualquiera del área, no solo admin):
      // solo puede tocar los campos de cancelación, nada del resto del
      // título (capital, guía, fechas, etc. — eso sigue siendo solo admin).
      // Un título ya cancelado por totalidad no admite más pagos: corregirlo
      // es de un admin (deshacer la cancelación).
      allow update: if esDelAreaIess() &&
                       resource.data.get('tipoCancelacion', null) != 'pago_total' &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['tipoCancelacion', 'estadoIess', 'montoCancelado', 'honorario', 'canceladoPor', 'fechaCancelacion', 'comprobantePago', 'pagos']) &&
                       request.resource.data.tipoCancelacion in ['abono', 'pago_total'] &&
                       request.resource.data.canceladoPor.uid == request.auth.uid;

      // Que el IESS ya haya pagado el honorario (honorarioCobrado,
      // honorarioCobradoPor, fechaCobroHonorario) es un evento aparte de la
      // cancelación y solo lo cambia un admin: no hay regla para el resto del
      // área, así que lo cubre únicamente el permiso general de admin de arriba.
      // Cualquiera del área sí puede registrar cancelaciones (regla anterior),
      // pero esa regla no deja tocar estos campos.
    }

    // Auditoría de cada importación: se crea, nunca se edita ni se borra.
    match /cargas_titulos/{cargaId} {
      allow read: if esDelAreaIess();
      allow create: if isAdmin() && request.resource.data.realizadoPor.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Auditoría de cada carga masiva de pagos ya cobrados: se crea, nunca
    // se edita ni se borra.
    match /cargas_pagos_honorarios/{cargaId} {
      allow read: if esDelAreaIess();
      allow create: if isAdmin() && request.resource.data.realizadoPor.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ============================================
    // 📑 Trámites del IESS (radiografías, anulaciones...)
    // Los ve y trabaja el admin y quien el admin haya elegido (campo
    // `tramitesIess` del registro, que solo un admin puede cambiar). Hay
    // dinero de por medio: no depende del área ni del rol de coordinador.
    // ============================================
    function puedeTramitesIess() {
      return isAuthenticated() && isActiveUser() &&
             (isAdmin() || getUserRegister().get('tramitesIess', false) == true);
    }

    match /tramites_iess/{tramiteId} {
      allow read: if puedeTramitesIess();

      allow create: if puedeTramitesIess() &&
                       request.resource.data.creadoPor.uid == request.auth.uid;

      // Quien no es admin agrega pero no achica el historial (cobros,
      // gestiones, costos): reversar y quitar es de admin. (Un pago quitado
      // de dentro de un costo a tercero no se distingue acá; eso lo exige la
      // pantalla.)
      allow update: if puedeTramitesIess() && (
        isAdmin() ||
        (request.resource.data.get('pagos', []).size() >= resource.data.get('pagos', []).size() &&
         request.resource.data.get('gestiones', []).size() >= resource.data.get('gestiones', []).size() &&
         request.resource.data.get('costosTerceros', []).size() >= resource.data.get('costosTerceros', []).size() &&
         request.resource.data.creadoPor == resource.data.creadoPor)
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // Concurso de disfraces (temporal). La página del jurado funciona SIN
    // sesión, así que estas reglas son las únicas que permiten acceso
    // público: lectura de participantes y estado, y crear un voto (uno por
    // nombre) mientras la votación esté abierta.
    // ============================================
    match /concurso_participantes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /concurso_estado/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un voto por nombre: el id del documento sale del nombre y las reglas
    // solo dejan CREARLO (un segundo voto con el mismo nombre es una
    // actualización, y esa solo la hace el admin). Sin sesión no se lee nada.
    match /concurso_votos/{clave} {
      allow read, update, delete: if isAdmin();

      allow create: if
        get(/databases/$(database)/documents/concurso_estado/actual).data.abierta == true &&
        request.resource.data.keys().hasOnly(['nombre', 'participanteId', 'razon', 'fecha']) &&
        request.resource.data.keys().hasAll(['nombre', 'participanteId', 'razon', 'fecha']) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() >= 2 &&
        request.resource.data.nombre.size() <= 80 &&
        request.resource.data.participanteId is string &&
        exists(/databases/$(database)/documents/concurso_participantes/$(request.resource.data.participanteId)) &&
        request.resource.data.razon is string &&
        request.resource.data.razon.size() >= 3 &&
        request.resource.data.razon.size() <= 500 &&
        request.resource.data.fecha == request.time;
    }

    // ============================================
    // itinerarios / rutasDiarias / procesos
    // El frontend hoy solo exige estar logueado para estas
    // rutas (no hay restricción por área/rol a nivel de
    // componente), así que las reglas reflejan exactamente
    // eso: cualquier usuario activo autenticado puede leer y
    // escribir. Restringir por área aquí sería un cambio de
    // producto, no solo de reglas — evaluar aparte.
    // ============================================
    match /itinerarios/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isActiveUser();
      allow delete: if isAdmin();
    }

    match /rutasDiarias/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isActiveUser();
    }

    match /procesos/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isActiveUser();
    }

    // ============================================
    // 💰 Roles de Pago — solo admin o gerente (RegistersService.canAccessPayroll)
    // ============================================
    match /payrollEmployees/{id} {
      // Además de admin/gerente, cada usuario puede leer su propio registro
      // (vinculado por uid) — lo necesita el módulo de Permisos y
      // Vacaciones para saber su fecha de afiliación IESS y su saldo.
      // Coordinador lee la lista completa para el resumen de saldos de
      // vacaciones por empleado (control de Permisos y Vacaciones).
      allow read: if isAdminOrGerente() || isCoordinador() ||
                     (isAuthenticated() && resource.data.uid == request.auth.uid);

      // Coordinador aprueba Vacaciones/permisos-con-descuento y eso resta
      // del saldo (SolicitudesPermisoService.descontarDelSaldo) — se le deja
      // tocar únicamente el saldo y la fecha hasta la que ya se sumaron los
      // aniversarios, nada más del empleado.
      allow write: if isAdminOrGerente() ||
                      (
                        isCoordinador() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saldoVacacionesDisponible', 'vacacionesAcreditadasHasta'])
                      );
    }

    match /sbuConfig/{anio} {
      allow read, write: if isAdminOrGerente();
    }

    match /rolesPago/{id} {
      allow read, create, update: if isAdminOrGerente();
      // Borrar un rol ya generado (aunque sea borrador) queda solo para
      // admin — puede haber una corrección y darse cuenta después de
      // haberlo impreso, no queremos que cualquiera con acceso lo borre.
      allow delete: if isAdmin();
    }

    // ============================================
    // 🌴 Solicitudes de Permiso y Vacaciones
    // Coordinador aprueba y controla TODAS las áreas (rol general para este
    // módulo, no restringido a la suya); admin/gerente igual.
    // ============================================
    function puedeAprobarSolicitudes() {
      return isAdminOrGerente() || isCoordinador();
    }

    match /solicitudesPermiso/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || puedeAprobarSolicitudes()
      );

      // Cada quien solo puede crear su propia solicitud, y siempre arranca 'pendiente'.
      allow create: if isAuthenticated() && isActiveUser() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.estado == 'pendiente';

      // Aprobar/rechazar/reabrir: cualquiera de los tres roles habilitados.
      // El dueño de la solicitud puede: subir/corregir su justificativo, o
      // (SolicitudesPermisoService.verificarYVencerSiCorresponde, que corre
      // sola al listar sus propias solicitudes) marcar como vencida una que
      // ya estaba aprobada y se pasó del plazo — nada más, no se autoaprueba
      // ni cambia fechas/motivo.
      allow update: if isAuthenticated() && (
        puedeAprobarSolicitudes() ||
        (
          resource.data.uid == request.auth.uid &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['justificativoUrl', 'justificativoSubidoEn']) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'descontadoDeVacaciones', 'diasDescontados']) &&
              resource.data.estado == 'aprobado' &&
              request.resource.data.estado == 'vencido_sin_justificativo'
            )
          )
        )
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // 📧 mail — cola de la extensión "Trigger Email" de Firebase.
    // Solo quien puede aprobar solicitudes puede disparar un correo; nadie
    // necesita leer/editar/borrar estos docs desde el cliente (la propia
    // extensión los procesa con Admin SDK, que ignora estas reglas).
    // ============================================
    match /mail/{id} {
      allow create: if isAuthenticated() && isActiveUser() &&
                       (isAdminOrGerente() || isCoordinador());
      allow read, update, delete: if false;
    }

    // Cola de la segunda instancia de "Trigger Email" (cuenta de notificaciones
    // del IESS). La extensión escribe `delivery` con el Admin SDK, así que el
    // cliente solo crea el documento y lo lee para saber si se entregó. Solo
    // admite el aviso pre-coactivo: el asunto va fijo (si cambia en
    // aviso-precoactivo.template.ts, hay que cambiarlo acá también) y como
    // máximo 10 destinatarios (MAX_DESTINATARIOS en correos-iess.util.ts).
    match /mail_iess/{id} {
      allow read: if esDelAreaIess();
      allow create: if esDelAreaIess() &&
                       request.resource.data.keys().hasOnly(['to', 'message']) &&
                       request.resource.data.to is list &&
                       request.resource.data.to.size() > 0 &&
                       request.resource.data.to.size() <= 10 &&
                       request.resource.data.message.keys().hasOnly(['subject', 'html', 'text']) &&
                       request.resource.data.message.subject == 'AVISO Pre-Coactivo IESS - Obligaciones Patronales' &&
                       request.resource.data.message.html is string &&
                       request.resource.data.message.html.size() < 100000 &&
                       request.resource.data.message.text is string &&
                       request.resource.data.message.text.size() < 100000;
      allow update, delete: if false;
    }

    // ============================================
    // 🚫 Todo lo demás: denegado por defecto
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
