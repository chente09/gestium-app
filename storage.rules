rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Solo usuarios logueados de la intranet, nunca público.
      allow read: if request.auth != null;

      // Solo usuarios activos pueden subir/editar/borrar archivos.
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/registers/$(request.auth.uid)).data.activo == true;
    }
  }
}
