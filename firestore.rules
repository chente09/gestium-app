rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // 🔐 FUNCIONES AUXILIARES DE SEGURIDAD
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRegister() {
      return get(/databases/$(database)/documents/registers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRegister().role == 'admin';
    }

    function isCoordinador() {
      return isAuthenticated() && getUserRegister().role == 'coordinador';
    }

    function isAdminOrCoordinador() {
      return isAdmin() || isCoordinador();
    }

    function isGerente() {
      return isAuthenticated() && getUserRegister().role == 'gerente';
    }

    function isAdminOrGerente() {
      return isAdmin() || isGerente();
    }

    function isActiveUser() {
      return isAuthenticated() && getUserRegister().activo == true;
    }

    function hasAreaAssigned() {
      return isAuthenticated() &&
             getUserRegister().areaAsignada != null &&
             getUserRegister().areaAsignada != 'sin_asignar';
    }

    function ownsArea(area) {
      return isAuthenticated() && getUserRegister().areaAsignada == area;
    }

    // Mismo patrón que el frontend (RegistersService.loginWithGoogle),
    // pero exigido acá también porque el chequeo en Angular es
    // saltable desde devtools llamando al SDK de Firebase directo.
    function hasAllowedEmail() {
      return isAuthenticated() &&
             (request.auth.token.email.matches('^.+[.]gestium@gmail[.]com$') ||
              request.auth.token.email.matches('^.+@gestium-sli[.]com$'));
    }

    // ============================================
    // 📋 registers — perfiles/roles (fuente de verdad)
    // ============================================
    match /registers/{userId} {
      // Solo usuarios logueados de la intranet, nunca público.
      allow read: if isAuthenticated();

      // Auto-registro: siempre como 'empleado', nunca con rol elevado.
      allow create: if isAuthenticated() &&
                       hasAllowedEmail() &&
                       request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.role == 'empleado';

      // El propio usuario no puede cambiarse su rol/área; admin sí puede.
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.areaAsignada == resource.data.areaAsignada) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // 🏢 areasOficina
    // ============================================
    match /areasOficina/{areaId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // 📊 area_activities — agenda por área
    // Empleado: solo su área. Admin/coordinador: todas.
    // ============================================
    match /area_activities/{activityId} {
      allow read: if isAuthenticated() && (
        isAdminOrCoordinador() || ownsArea(resource.data.area)
      );

      allow create: if isAuthenticated() &&
                       isActiveUser() &&
                       hasAreaAssigned() &&
                       request.resource.data.creadoPor == request.auth.uid &&
                       request.resource.data.titulo != null &&
                       request.resource.data.estado != null &&
                       (isAdminOrCoordinador() ||
                        request.resource.data.area == getUserRegister().areaAsignada);

      // No se puede cambiar el área ni el creador.
      allow update: if isAuthenticated() &&
                       isActiveUser() &&
                       (resource.data.creadoPor == request.auth.uid || isAdminOrCoordinador()) &&
                       request.resource.data.area == resource.data.area &&
                       request.resource.data.creadoPor == resource.data.creadoPor;

      allow delete: if isAuthenticated() &&
                       isActiveUser() &&
                       (resource.data.creadoPor == request.auth.uid || isAdminOrCoordinador());
    }

    // ============================================
    // itinerarios / rutasDiarias / procesos
    // El frontend hoy solo exige estar logueado para estas
    // rutas (no hay restricción por área/rol a nivel de
    // componente), así que las reglas reflejan exactamente
    // eso: cualquier usuario activo autenticado puede leer y
    // escribir. Restringir por área aquí sería un cambio de
    // producto, no solo de reglas — evaluar aparte.
    // ============================================
    match /itinerarios/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isActiveUser();
      allow delete: if isAdmin();
    }

    match /rutasDiarias/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isActiveUser();
    }

    match /procesos/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isActiveUser();
    }

    // ============================================
    // 💰 Roles de Pago — solo admin o gerente (RegistersService.canAccessPayroll)
    // ============================================
    match /payrollEmployees/{id} {
      // Además de admin/gerente, cada usuario puede leer su propio registro
      // (vinculado por uid) — lo necesita el módulo de Permisos y
      // Vacaciones para saber su fecha de afiliación IESS y su saldo.
      // Coordinador lee la lista completa para el resumen de saldos de
      // vacaciones por empleado (control de Permisos y Vacaciones).
      allow read: if isAdminOrGerente() || isCoordinador() ||
                     (isAuthenticated() && resource.data.uid == request.auth.uid);

      // Coordinador aprueba Vacaciones/permisos-con-descuento y eso resta
      // del saldo (SolicitudesPermisoService.descontarDiasDeVacaciones) —
      // se le deja tocar únicamente ese campo, nada más del empleado.
      allow write: if isAdminOrGerente() ||
                      (
                        isCoordinador() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saldoVacacionesDisponible'])
                      );
    }

    match /sbuConfig/{anio} {
      allow read, write: if isAdminOrGerente();
    }

    match /rolesPago/{id} {
      allow read, create, update: if isAdminOrGerente();
      // Borrar un rol ya generado (aunque sea borrador) queda solo para
      // admin — puede haber una corrección y darse cuenta después de
      // haberlo impreso, no queremos que cualquiera con acceso lo borre.
      allow delete: if isAdmin();
    }

    // ============================================
    // 🌴 Solicitudes de Permiso y Vacaciones
    // Coordinador aprueba y controla TODAS las áreas (rol general para este
    // módulo, no restringido a la suya); admin/gerente igual.
    // ============================================
    function puedeAprobarSolicitudes() {
      return isAdminOrGerente() || isCoordinador();
    }

    match /solicitudesPermiso/{id} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || puedeAprobarSolicitudes()
      );

      // Cada quien solo puede crear su propia solicitud, y siempre arranca 'pendiente'.
      allow create: if isAuthenticated() && isActiveUser() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.estado == 'pendiente';

      // Aprobar/rechazar/reabrir: cualquiera de los tres roles habilitados.
      // El dueño de la solicitud puede: subir/corregir su justificativo, o
      // (SolicitudesPermisoService.verificarYVencerSiCorresponde, que corre
      // sola al listar sus propias solicitudes) marcar como vencida una que
      // ya estaba aprobada y se pasó del plazo — nada más, no se autoaprueba
      // ni cambia fechas/motivo.
      allow update: if isAuthenticated() && (
        puedeAprobarSolicitudes() ||
        (
          resource.data.uid == request.auth.uid &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['justificativoUrl', 'justificativoSubidoEn']) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'descontadoDeVacaciones']) &&
              resource.data.estado == 'aprobado' &&
              request.resource.data.estado == 'vencido_sin_justificativo'
            )
          )
        )
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // 📧 mail — cola de la extensión "Trigger Email" de Firebase.
    // Solo quien puede aprobar solicitudes puede disparar un correo; nadie
    // necesita leer/editar/borrar estos docs desde el cliente (la propia
    // extensión los procesa con Admin SDK, que ignora estas reglas).
    // ============================================
    match /mail/{id} {
      allow create: if isAuthenticated() && isActiveUser() &&
                       (isAdminOrGerente() || isCoordinador());
      allow read, update, delete: if false;
    }

    // ============================================
    // 🚫 Todo lo demás: denegado por defecto
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
